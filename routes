@app.route('/usuario/reclamacao', methods=['POST'])
def obter_reclamacao():

    dados = tratar_dados()
    cpf = cpf_enviado()
    reclamacao = dados.get('reclamacao')
    if not reclamacao:
        return jsonify({
            'status': 'error',
            'mensagem': 'Reclamação não enviada'
        }), 400

    reclamacao_criada, erro = criar_reclamacao(cpf, reclamacao)
    if erro:
        return erro
    
    return reclamacao_criada

