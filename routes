from flask import Flask, jsonify
import bcrypt
from services import (
    validarCPF,
    tratar_dados,
    cpf_enviado,
    autenticar_usuario,
    inserir_usuario,
    criar_reclamacao
)

app = Flask(__name__)

@app.route('/usuario/login', methods=['POST'])
def consultar_usuario():

    dados = tratar_dados()
    cpf = cpf_enviado()
    senha_digitada = dados.get('senha')

    cpf, erro = validarCPF()
    if erro:
        return erro

    usuario, erro = autenticar_usuario(cpf, senha_digitada)
    if erro:
        return erro

    return usuario
